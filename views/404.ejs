<%- include('./partials/head') %>
<body class="bg-slate-50/40 text-slate-800 font-sans min-h-screen flex flex-col antialiased">
  <main class="flex-grow flex flex-col items-center justify-center text-center p-6 space-y-6 max-w-md mx-auto">
    <!-- Icon/Illustration -->
    <div class="w-24 h-24 bg-rose-50 text-rose-550 border border-rose-100/60 rounded-3xl flex items-center justify-center shadow-inner animate-bounce">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
      </svg>
    </div>
    
    <div class="space-y-2">
      <h1 class="text-6xl font-extrabold text-slate-900 tracking-tight">404</h1>
      <h2 class="text-xl font-bold text-slate-800">Stay not found</h2>
      <p class="text-sm text-slate-400 max-w-xs mx-auto leading-relaxed">
        The destination you are trying to visit doesn't exist, or has been relocated to another address.
      </p>
    </div>

    <a 
      href="/" 
      class="inline-flex items-center gap-1.5 px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-sm transition-all duration-300 shadow-md shadow-indigo-100 cursor-pointer active:scale-95"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
      </svg>
      <span>Return Home</span>
    </a>
  </main>
</body>
</html>