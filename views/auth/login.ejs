<%- include('../partials/head') %>
<body class="bg-slate-50/40 text-slate-800 font-sans min-h-screen flex flex-col antialiased">
  <%- include('../partials/nav') %>

  <main class="flex-grow flex items-center justify-center px-6 py-12 relative overflow-hidden">
    <!-- Blurry ambient blobs -->
    <div class="absolute top-1/4 left-1/3 w-64 h-64 bg-indigo-100/50 rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-1/4 right-1/3 w-64 h-64 bg-purple-100/40 rounded-full blur-3xl -z-10"></div>

    <div class="w-full max-w-md bg-white border border-slate-200/50 shadow-xl shadow-slate-100/60 rounded-3xl p-8 space-y-6 relative z-10">
      <!-- Title Header -->
      <div class="text-center space-y-2">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Welcome Back</h1>
        <p class="text-sm text-slate-400">
          New to easyEstate? 
          <a href="/signup" class="text-indigo-600 hover:text-indigo-800 font-bold transition">Sign Up</a>
        </p>
      </div>

      <!-- Errors Integration -->
      <%- include('../partials/errors') %>

      <!-- Form -->
      <form action="/login" method="POST" class="space-y-4">
        <div class="space-y-1.5">
          <label for="email" class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="name@example.com"
            value="<%= oldInput.email %>"
            required
            class="w-full px-4 py-3 bg-slate-50/60 border border-slate-200 focus:bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-sm placeholder:text-slate-400 font-medium"
          />
        </div>

        <div class="space-y-1.5">
          <div class="flex justify-between items-center">
            <label for="password" class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Password</label>
          </div>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••"
            required
            class="w-full px-4 py-3 bg-slate-50/60 border border-slate-200 focus:bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-sm placeholder:text-slate-400 font-medium"
          />
        </div>

        <!-- Submit Button -->
        <button 
          type="submit" 
          class="w-full mt-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 active:scale-98 shadow-md shadow-indigo-100 hover:shadow flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <span>Sign In</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </button>
      </form>
    </div>
  </main>
</body>
</html>