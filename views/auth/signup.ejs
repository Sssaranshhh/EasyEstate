<%- include('../partials/head') %>
<body class="bg-slate-50/40 text-slate-800 font-sans min-h-screen flex flex-col antialiased">
  <%- include('../partials/nav') %>

  <main class="flex-grow flex items-center justify-center px-6 py-12 relative overflow-hidden">
    <!-- Blurry ambient blobs -->
    <div class="absolute top-1/4 left-1/3 w-72 h-72 bg-indigo-100/50 rounded-full blur-3xl -z-10"></div>
    <div class="absolute bottom-1/4 right-1/3 w-72 h-72 bg-purple-100/40 rounded-full blur-3xl -z-10"></div>

    <div class="w-full max-w-xl bg-white border border-slate-200/50 shadow-xl shadow-slate-100/60 rounded-3xl p-8 space-y-6 relative z-10">
      <!-- Title Header -->
      <div class="text-center space-y-2">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Create your Account</h1>
        <p class="text-sm text-slate-400">
          Already have an account? 
          <a href="/login" class="text-indigo-600 hover:text-indigo-800 font-bold transition">Sign In</a>
        </p>
      </div>

      <!-- Errors Integration -->
      <%- include('../partials/errors') %>

      <!-- Form -->
      <form action="/signup" method="POST" class="space-y-4">
        
        <!-- First and Last Name row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="firstName" class="block text-xs font-bold text-slate-500 uppercase tracking-wider">First Name</label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              placeholder="John"
              value="<%= oldInput.firstName %>"
              required
              class="w-full px-4 py-2.5 bg-slate-50/60 border border-slate-200 focus:bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-sm placeholder:text-slate-400 font-medium"
            />
          </div>

          <div class="space-y-1.5">
            <label for="lastName" class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Last Name</label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              placeholder="Doe"
              value="<%= oldInput.lastName %>"
              class="w-full px-4 py-2.5 bg-slate-50/60 border border-slate-200 focus:bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-sm placeholder:text-slate-400 font-medium"
            />
          </div>
        </div>

        <!-- Email -->
        <div class="space-y-1.5">
          <label for="email" class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="john.doe@example.com"
            value="<%= oldInput.email %>"
            required
            class="w-full px-4 py-2.5 bg-slate-50/60 border border-slate-200 focus:bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-sm placeholder:text-slate-400 font-medium"
          />
        </div>

        <!-- Password and Confirm Password row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="password" class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Min. 8 chars"
              required
              class="w-full px-4 py-2.5 bg-slate-50/60 border border-slate-200 focus:bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-sm placeholder:text-slate-400 font-medium"
            />
          </div>

          <div class="space-y-1.5">
            <label for="confirmPassword" class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Confirm Password</label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              placeholder="Verify password"
              required
              class="w-full px-4 py-2.5 bg-slate-50/60 border border-slate-200 focus:bg-white rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-sm placeholder:text-slate-400 font-medium"
            />
          </div>
        </div>

        <!-- User Type Segmented Radio Cards -->
        <div class="space-y-2">
          <span class="block text-xs font-bold text-slate-500 uppercase tracking-wider">Join easyEstate as a:</span>
          
          <div class="grid grid-cols-2 gap-4">
            <!-- Guest Card -->
            <label class="relative cursor-pointer">
              <input
                type="radio"
                name="userType"
                value="guest"
                id="guest"
                <%= oldInput.userType === 'guest' || !oldInput.userType ? 'checked' : '' %>
                class="peer sr-only"
              />
              <div class="p-4 border border-slate-200 rounded-2xl flex flex-col items-center justify-center gap-2 hover:bg-slate-50 peer-checked:border-indigo-600 peer-checked:bg-indigo-50/40 peer-checked:ring-1 peer-checked:ring-indigo-650 transition duration-200 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-slate-400 group-hover:text-slate-600 peer-checked:text-indigo-600">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>
                <span class="font-bold text-sm text-slate-800">Guest</span>
                <span class="text-[10px] text-slate-400 font-semibold leading-none">Find & book stays</span>
              </div>
            </label>

            <!-- Host Card -->
            <label class="relative cursor-pointer">
              <input
                type="radio"
                name="userType"
                value="host"
                id="host"
                <%= oldInput.userType === 'host' ? 'checked' : '' %>
                class="peer sr-only"
              />
              <div class="p-4 border border-slate-200 rounded-2xl flex flex-col items-center justify-center gap-2 hover:bg-slate-50 peer-checked:border-indigo-600 peer-checked:bg-indigo-50/40 peer-checked:ring-1 peer-checked:ring-indigo-650 transition duration-200 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-slate-400 group-hover:text-slate-600 peer-checked:text-indigo-600">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                </svg>
                <span class="font-bold text-sm text-slate-800">Host</span>
                <span class="text-[10px] text-slate-400 font-semibold leading-none">List & rent homes</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Terms and Conditions checkbox -->
        <div class="flex items-start gap-2.5 pt-2">
          <input
            type="checkbox"
            name="terms"
            id="terms"
            <%= termsAccepted ? 'checked' : '' %>
            class="mt-1 w-4.5 h-4.5 rounded-lg border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer"
          />
          <label for="terms" class="text-xs text-slate-500 font-semibold leading-normal cursor-pointer select-none">
            I agree to the 
            <a href="#" class="text-indigo-600 hover:text-indigo-850 hover:underline">Terms of Service</a> 
            and 
            <a href="#" class="text-indigo-600 hover:text-indigo-850 hover:underline">Privacy Policy</a>
          </label>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full mt-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 active:scale-98 shadow-md shadow-indigo-100 hover:shadow flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <span>Register Account</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </button>
      </form>
    </div>
  </main>
</body>
</html>
