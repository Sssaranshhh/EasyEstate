<%- include('../partials/head') %>
<body class="bg-slate-50/40 text-slate-800 font-sans min-h-screen flex flex-col antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-6xl mx-auto px-6 py-12 w-full flex-grow">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-slate-200/60 pb-6 mb-10 gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Your Listings Dashboard</h1>
        <p class="text-sm text-slate-400 mt-1.5">Manage the homes you've listed for rent on easyEstate.</p>
      </div>
      <a 
        href="/host/add-home" 
        class="inline-flex items-center gap-1.5 px-4.5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-sm transition-all duration-300 shadow-sm shadow-indigo-150 hover:shadow active:scale-95 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        <span>Add New Home</span>
      </a>
    </div>

    <% if (regHomes && regHomes.length > 0) { %>
      <ul class="space-y-6">
        <% regHomes.forEach(home => { %>
          <li class="flex flex-col md:flex-row bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
            <!-- Image Frame -->
            <div class="md:w-1/3 h-52 md:h-auto overflow-hidden bg-slate-100 shrink-0">
              <img 
                src="/<%= home.houseImage %>" 
                alt="<%= home.homeName %>" 
                class="object-cover w-full h-full"
              />
            </div>
            
            <!-- Details Area -->
            <div class="md:w-2/3 p-6 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <div class="flex items-center gap-1 text-slate-400 text-xs font-semibold">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-indigo-500">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                  <span><%= home.location %></span>
                </div>
                
                <h3 class="text-xl font-bold text-slate-900"><%= home.homeName %></h3>
                
                <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-slate-500">
                  <span class="inline-flex items-center bg-slate-50 text-slate-700 border border-slate-150/40 px-2.5 py-1 rounded-lg">
                    Rent: &nbsp;<strong class="text-slate-900">₹<%= home.rentPerMonth.toLocaleString() %></strong>/mo
                  </span>
                  
                  <span class="inline-flex items-center gap-1 bg-amber-50 text-amber-800 border border-amber-100 px-2.5 py-1 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-amber-500">
                      <path fill-rule="evenodd" d="M10.788 2.903a.75.75 0 0 1 .424.424l2.176 4.417 4.873.708a.75.75 0 0 1 .416 1.279l-3.526 3.437 1.029 4.87a.75.75 0 0 1-1.088.791L12 18.347l-4.366 2.293a.75.75 0 0 1-1.088-.791l1.03-4.87-3.526-3.436a.75.75 0 0 1 .416-1.279l4.873-.708 2.176-4.417a.75.75 0 0 1 .424-.424Z" clip-rule="evenodd" />
                    </svg>
                    <%= home.rating %> / 5.0
                  </span>
                </div>

                <p class="text-slate-500 text-xs line-clamp-2 leading-relaxed pt-2 border-t border-slate-100">
                  <%= home.description || 'No description added yet for this listed stay.' %>
                </p>
              </div>

              <!-- Action Triggers -->
              <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
                <a 
                  href="/host/edit-home/<%= home._id %>?editing=true" 
                  class="inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-slate-900 hover:bg-indigo-650 text-white font-semibold rounded-xl text-xs transition duration-200 cursor-pointer active:scale-95 shadow-sm"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.83 20.013a4.5 4.5 0 0 1-1.89 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                  </svg>
                  <span>Edit details</span>
                </a>

                <form action="/host/delete-home/<%= home._id %>" method="POST" class="inline">
                  <button 
                    type="submit" 
                    class="inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-xl text-xs font-semibold transition duration-200 cursor-pointer active:scale-95 shadow-sm border border-rose-100/50"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                    <span>Delete</span>
                  </button>
                </form>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <!-- Empty State -->
      <div class="text-center py-24 bg-white rounded-3xl border border-slate-100 shadow-sm max-w-xl mx-auto px-6 space-y-5">
        <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto text-slate-400 border border-slate-100">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-indigo-600">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <div class="space-y-1">
          <h3 class="text-lg font-bold text-slate-800">You haven't listed any homes yet</h3>
          <p class="text-sm text-slate-400 max-w-sm mx-auto leading-relaxed">
            As a host, you can list properties to rent them out. Let's create your first listing!
          </p>
        </div>
        <a 
          href="/host/add-home" 
          class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-sm transition duration-200 active:scale-95 shadow-md shadow-indigo-100 cursor-pointer"
        >
          <span>List a Property</span>
        </a>
      </div>
    <% } %>
  </main>
</body>
</html>