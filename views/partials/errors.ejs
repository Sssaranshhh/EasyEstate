<% if (typeof errors !== 'undefined' && errors.length > 0) { %>
  <div class="bg-rose-50/70 border border-rose-250/50 text-rose-800 px-5 py-4 rounded-2xl max-w-xl mx-auto shadow-sm flex gap-3.5 items-start">
    <div class="text-rose-500 shrink-0 mt-0.5">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5.5 h-5.5">
        <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003ZM12 8.25a.75.75 0 0 1 .75.75v3.75a.75.75 0 0 1-1.5 0V9a.75.75 0 0 1 .75-.75Zm0 8.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z" clip-rule="evenodd" />
      </svg>
    </div>
    <div class="space-y-1">
      <h4 class="font-extrabold text-sm tracking-tight text-rose-900">Please correct the following:</h4>
      <ul class="list-disc list-inside text-xs font-semibold text-rose-700/90 space-y-1">
        <% errors.forEach(error => { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    </div>
  </div>
<% } %>
