<%- include('../partials/head') %>
<body class="bg-slate-50/40 text-slate-800 font-sans min-h-screen flex flex-col antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-6xl mx-auto px-6 py-10 w-full flex-grow">
    <!-- Back Button -->
    <div class="mb-6">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm font-bold text-slate-500 hover:text-indigo-600 transition-colors group">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transition-transform group-hover:-translate-x-0.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        <span>Back to Explorations</span>
      </a>
    </div>

    <!-- Details Container -->
    <div class="grid gap-8 lg:grid-cols-12 bg-white border border-slate-100 rounded-3xl overflow-hidden p-6 sm:p-8 shadow-sm">
      <!-- Left side: Image and Quick Stats -->
      <div class="lg:col-span-7 space-y-6">
        <div class="relative w-full h-[320px] sm:h-[420px] rounded-2xl overflow-hidden bg-slate-50 border border-slate-100 shadow-inner">
          <img 
            src="/<%= home.houseImage %>" 
            alt="<%= home.homeName %>" 
            class="w-full h-full object-cover"
          >
          
          <!-- Rating Floating Pill -->
          <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-md px-3.5 py-1.5 rounded-full text-sm font-bold text-slate-850 flex items-center gap-1 shadow-md border border-slate-100/50">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-amber-500">
              <path fill-rule="evenodd" d="M10.788 2.903a.75.75 0 0 1 .424.424l2.176 4.417 4.873.708a.75.75 0 0 1 .416 1.279l-3.526 3.437 1.029 4.87a.75.75 0 0 1-1.088.791L12 18.347l-4.366 2.293a.75.75 0 0 1-1.088-.791l1.03-4.87-3.526-3.436a.75.75 0 0 1 .416-1.279l4.873-.708 2.176-4.417a.75.75 0 0 1 .424-.424Z" clip-rule="evenodd" />
            </svg>
            <span><%= home.rating %></span>
            <span class="text-xs text-slate-400 font-medium">/ 5.0 rating</span>
          </div>
        </div>
      </div>

      <!-- Right side: Info Panel -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-8">
        <div class="space-y-6">
          <div class="space-y-3">
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
              ⚡ Available for Rent
            </span>
            <h1 class="text-3xl font-extrabold text-slate-900 leading-tight tracking-tight">
              <%= home.homeName %>
            </h1>
            <div class="flex items-center gap-1.5 text-slate-500 font-medium text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-indigo-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
              <span><%= home.location %></span>
            </div>
          </div>

          <div class="border-t border-slate-100 pt-5 space-y-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">About this property</h3>
            <p class="text-slate-600 text-sm leading-relaxed whitespace-pre-line">
              <%= home.description || 'Welcome to this beautiful estate listing. Carefully constructed and located in a prime neighborhood, this listing offers a peaceful environment, comfortable spacing, and amazing ventilation.' %>
            </p>
          </div>
        </div>

        <!-- Pricing Dashboard Card -->
        <div class="bg-slate-50 rounded-2xl border border-slate-100 p-5 mt-6 space-y-4">
          <div class="flex justify-between items-baseline">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Monthly Rent</span>
            <div class="text-right">
              <span class="text-2xl font-extrabold text-slate-900">₹<%= home.rentPerMonth.toLocaleString() %></span>
              <span class="text-xs text-slate-400 font-semibold"> / month</span>
            </div>
          </div>

          <div class="border-t border-slate-200/60 pt-4 flex items-center justify-between">
            <span class="text-xs text-slate-400">Includes all standard amenities</span>
            <%- include('../partials/favourite', {home: home}) %>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>