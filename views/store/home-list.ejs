<%- include('../partials/head') %>
<body class="bg-slate-50/40 text-slate-800 font-sans min-h-screen flex flex-col antialiased">
  <%- include('../partials/nav') %>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-12 w-full flex-grow">
    <!-- Header -->
    <div class="border-b border-slate-200/60 pb-6 mb-10">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Explore Registered Homes</h1>
      <p class="text-sm text-slate-400 mt-1.5">Browse through our curated collection of verified rentals.</p>
    </div>

    <% if (regHomes && regHomes.length > 0) { %>
      <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <% regHomes.forEach(home => { %>
          <li class="group bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col overflow-hidden">
            <!-- Image Frame -->
            <div class="relative w-full h-56 overflow-hidden bg-slate-100">
              <img 
                src="/<%= home.houseImage %>" 
                alt="<%= home.homeName %>" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              >
              
              <!-- Floating Rating Badge -->
              <div class="absolute top-3.5 right-3.5 bg-white/90 backdrop-blur-md px-2.5 py-1 rounded-full text-xs font-bold text-slate-800 flex items-center gap-1 shadow-sm border border-slate-100/50">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-amber-500">
                  <path fill-rule="evenodd" d="M10.788 2.903a.75.75 0 0 1 .424.424l2.176 4.417 4.873.708a.75.75 0 0 1 .416 1.279l-3.526 3.437 1.029 4.87a.75.75 0 0 1-1.088.791L12 18.347l-4.366 2.293a.75.75 0 0 1-1.088-.791l1.03-4.87-3.526-3.436a.75.75 0 0 1 .416-1.279l4.873-.708 2.176-4.417a.75.75 0 0 1 .424-.424Z" clip-rule="evenodd" />
                </svg>
                <span><%= home.rating %></span>
              </div>
            </div>

            <!-- Content Area -->
            <div class="flex-1 p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-1.5">
                <div class="flex items-center gap-1 text-slate-400 text-xs font-semibold">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-indigo-500">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                  <span><%= home.location %></span>
                </div>
                <h3 class="text-lg font-bold text-slate-800 group-hover:text-indigo-600 transition-colors duration-200 line-clamp-1">
                  <%= home.homeName %>
                </h3>
                <p class="text-slate-500 text-xs line-clamp-2 leading-relaxed">
                  <%= home.description || 'No description provided for this stay.' %>
                </p>
              </div>

              <!-- Price Tag and Actions -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-4">
                <div>
                  <p class="text-[10px] uppercase tracking-wider font-extrabold text-slate-400 leading-none">Rent</p>
                  <p class="text-base font-extrabold text-slate-900 mt-0.5">
                    ₹<%= home.rentPerMonth.toLocaleString() %><span class="text-xs text-slate-400 font-medium">/mo</span>
                  </p>
                </div>
                
                <div class="flex items-center gap-2">
                  <a 
                    href="/homes/<%= home._id %>" 
                    class="inline-flex items-center justify-center px-3.5 py-2 bg-slate-900 hover:bg-indigo-600 text-white font-semibold rounded-xl text-xs transition duration-200 cursor-pointer active:scale-95 shadow-sm"
                  >
                    Details
                  </a>
                  <%- include('../partials/favourite', {home: home}) %>
                </div>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="text-center py-20 bg-white rounded-3xl border border-slate-100 shadow-sm max-w-xl mx-auto px-6 space-y-4">
        <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto text-slate-400 border border-slate-100">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-800">No properties registered yet</h3>
        <p class="text-sm text-slate-400 max-w-sm mx-auto leading-relaxed">
          Check back later, or add your own property if you are a host!
        </p>
      </div>
    <% } %>
  </div>
</body>
</html>