<%- include('../partials/head') %>
<body class="bg-slate-50/40 text-slate-800 font-sans min-h-screen flex flex-col antialiased">
  <%- include('../partials/nav') %>

  <!-- Hero Section -->
  <main class="relative overflow-hidden py-20 px-6 sm:px-12 lg:px-16 text-center max-w-7xl mx-auto w-full">
    <!-- Glowing background elements -->
    <div class="absolute top-1/2 left-1/4 -translate-y-1/2 -translate-x-1/2 w-72 h-72 bg-indigo-200/40 rounded-full blur-3xl -z-10"></div>
    <div class="absolute top-1/3 right-1/4 -translate-y-1/2 translate-x-1/2 w-80 h-80 bg-violet-200/30 rounded-full blur-3xl -z-10"></div>

    <div class="relative z-10 max-w-3xl mx-auto space-y-6">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100/80">
        ✨ A Premium Real Estate Experience
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-none">
        Find Your Perfect Stay with <span class="bg-gradient-to-r from-indigo-600 via-purple-600 to-violet-600 bg-clip-text text-transparent">easyEstate</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
        Discover hand-picked homes, villas, and apartments for rent. Seamless booking, transparent pricing, and verified hosts.
      </p>

      <!-- Decorative Mock Search Bar (Static) -->
      <div class="pt-4 max-w-2xl mx-auto">
        <div class="p-2 bg-white rounded-2xl shadow-xl shadow-slate-100/80 border border-slate-100/90 flex flex-col sm:flex-row gap-2">
          <div class="flex-1 flex items-center gap-2 px-3 py-2 text-left">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-slate-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.637 10.637Z" />
            </svg>
            <span class="text-sm text-slate-400">Where are you looking to stay?</span>
          </div>
          <div class="h-px sm:h-8 w-full sm:w-px bg-slate-100"></div>
          <div class="flex-1 flex items-center gap-2 px-3 py-2 text-left">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-slate-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.736.156A3.976 3.976 0 0 0 12 15.5cc1.047 0 2.052-.312 2.684-.889m0 0c.9-.803.9-2.07 0-2.873-.631-.578-1.637-.889-2.684-.889a5.076 5.076 0 0 1-1.684-.315C9.678 9.204 9.678 8.04 10.5 7.4c.63-.578 1.637-.889 2.684-.889.85 0 1.685.204 2.268.571M12 6.75v8.5" />
            </svg>
            <span class="text-sm text-slate-400">Any budget</span>
          </div>
          <button class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-2.5 rounded-xl text-sm transition duration-200 active:scale-98 shadow-md shadow-indigo-100 flex items-center justify-center gap-1.5 cursor-pointer">
            <span>Explore</span>
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- Homes Grid Section -->
  <section class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pb-24 w-full">
    <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-4 border-b border-slate-100 pb-5">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Featured Properties</h2>
        <p class="text-sm text-slate-400 mt-1">Explore our top verified listings registered around you.</p>
      </div>
      <% if(isLoggedIn && user && user.userType === "guest") { %>
        <a href="/home-list" class="inline-flex items-center gap-1 text-sm font-bold text-indigo-600 hover:text-indigo-800 transition">
          View all homes 
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      <% } %>
    </div>

    <% if (regHomes && regHomes.length > 0) { %>
      <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <% regHomes.forEach(home => { %>
          <li class="group bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col overflow-hidden">
            <!-- Image Frame -->
            <div class="relative w-full h-56 overflow-hidden bg-slate-100">
              <img 
                src="/<%= home.houseImage %>" 
                alt="<%= home.homeName %>" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              >
              
              <!-- Floating Rating Badge -->
              <div class="absolute top-3.5 right-3.5 bg-white/90 backdrop-blur-md px-2.5 py-1 rounded-full text-xs font-bold text-slate-800 flex items-center gap-1 shadow-sm border border-slate-100/50">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-amber-500">
                  <path fill-rule="evenodd" d="M10.788 2.903a.75.75 0 0 1 .424.424l2.176 4.417 4.873.708a.75.75 0 0 1 .416 1.279l-3.526 3.437 1.029 4.87a.75.75 0 0 1-1.088.791L12 18.347l-4.366 2.293a.75.75 0 0 1-1.088-.791l1.03-4.87-3.526-3.436a.75.75 0 0 1 .416-1.279l4.873-.708 2.176-4.417a.75.75 0 0 1 .424-.424Z" clip-rule="evenodd" />
                </svg>
                <span><%= home.rating %></span>
              </div>
            </div>

            <!-- Content Area -->
            <div class="flex-1 p-5 flex flex-col justify-between space-y-4">
              <div class="space-y-1.5">
                <div class="flex items-center gap-1 text-slate-400 text-xs font-semibold">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 text-indigo-500">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                  <span><%= home.location %></span>
                </div>
                <h3 class="text-lg font-bold text-slate-800 group-hover:text-indigo-600 transition-colors duration-200 line-clamp-1">
                  <%= home.homeName %>
                </h3>
                <p class="text-slate-500 text-xs line-clamp-2 leading-relaxed">
                  <%= home.description || 'No description provided for this beautiful stay.' %>
                </p>
              </div>

              <!-- Price Tag and Actions -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-4">
                <div>
                  <p class="text-[10px] uppercase tracking-wider font-extrabold text-slate-400 leading-none">Rent</p>
                  <p class="text-base font-extrabold text-slate-900 mt-0.5">
                    ₹<%= home.rentPerMonth.toLocaleString() %><span class="text-xs text-slate-400 font-medium">/mo</span>
                  </p>
                </div>
                
                <div class="flex items-center gap-2">
                  <a 
                    href="/homes/<%= home._id %>" 
                    class="inline-flex items-center justify-center px-3.5 py-2 bg-slate-900 hover:bg-indigo-600 text-white font-semibold rounded-xl text-xs transition duration-200 cursor-pointer active:scale-95 shadow-sm"
                  >
                    Details
                  </a>
                  <%- include('../partials/favourite', {home: home}) %>
                </div>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="text-center py-20 bg-white rounded-3xl border border-slate-100 shadow-sm max-w-xl mx-auto px-6 space-y-4">
        <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto text-slate-400 border border-slate-100">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-800">No properties registered yet</h3>
        <p class="text-sm text-slate-400 max-w-sm mx-auto leading-relaxed">
          Be the first one to register a beautiful home! If you are a host, please login and list a house.
        </p>
      </div>
    <% } %>
  </section>
</body>
</html>